# ==============================================================================
# SismoWatch Enterprise - Configuration Template (.env.example)
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL & pgvector Serving Database
# (Note: In this architecture, PostgreSQL only hosts the GOLD layer)
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433
POSTGRES_DB=sismowatch_db
POSTGRES_USER=sismowatch_admin
POSTGRES_PASSWORD=sismowatch_secure_pass_2026

# Mínimo Privilegio - Roles
DB_SPARK_PASS=spark_etl_secure_pass_2026
DB_API_READER_PASS=api_reader_secure_pass_2026

# ------------------------------------------------------------------------------
# 2. MinIO (S3-Compatible Object Store for Bronze & Silver Lakehouse Layers)
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword2026
MINIO_BUCKET_BRONZE=sismowatch-bronze
MINIO_BUCKET_SILVER=sismowatch-silver
MINIO_BUCKET_GOLD=sismowatch-gold
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=miniopassword2026
AWS_DEFAULT_REGION=us-east-1

# ------------------------------------------------------------------------------
# 3. Apache Airflow Configuration
# ------------------------------------------------------------------------------
AIRFLOW_IMAGE_NAME=apache/airflow:2.9.1-python3.11
AIRFLOW_UID=50000
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=False
AIRFLOW__CORE__FERNET_KEY=vX-yK7zP4Q8wR2tM1sN6bV9cL3jF5hG0aD8eS2uI4oE=
AIRFLOW__API__AUTH_BACKENDS=airflow.api.auth.backend.basic_auth,airflow.api.auth.backend.session
_AIRFLOW_WWW_USER_USERNAME=airflow_admin
_AIRFLOW_WWW_USER_PASSWORD=airflow_super_secure_pass_2026

# ------------------------------------------------------------------------------
# 4. Security, JWT & Application Admin
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=sismowatch_enterprise_jwt_ultra_secret_key_2026_xyz
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

ADMIN_USER=admin@sismowatch.com
ADMIN_PASSWORD=AdminSecurePass2026!

VIEWER_USER=viewer@sismowatch.com
VIEWER_PASSWORD=ViewerPass2026!

# ------------------------------------------------------------------------------
# 5. AI / LLM Integration & Anti-Hallucination Controls
# ------------------------------------------------------------------------------
LLM_PROVIDER=mock_fallback # Options: gemini, openai, ollama, mock_fallback
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL_NAME=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 6. USGS Earthquake API Configuration
# ------------------------------------------------------------------------------
USGS_REALTIME_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson
USGS_QUERY_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
REQUEST_TIMEOUT_SECONDS=10
MAX_RETRIES=5
